      "handlerKey": "production-server-critical-unsupported-os",
      "displayOrder": 4,
      "name": "Production Server Critical Unsupported OS Rule",
      "description": "Evaluates production servers for the high-risk combination of critical vulnerability and unsupported OS.",
      "enabled": true,
      "parameters": [
        {
          "parameterKey": "environmentType",
          "parameterType": "string",
          "required": false,
          "defaultValue": "Production",
          "allowedValues": ["Production", "Development", "UAT", "Test"],
          "displayOrder": 1,
          "description": "System environment type in scope."
        },
        {
          "parameterKey": "vulnerabilitySeverity",
          "parameterType": "string",
          "required": false,
          "defaultValue": "Critical",
          "allowedValues": ["Low", "Medium", "High", "Critical"],
          "displayOrder": 2,
          "description": "Vulnerability severity that contributes to the high-risk condition."
        },
        {
          "parameterKey": "unsupportedStatus",
          "parameterType": "string",
          "required": false,
          "defaultValue": "OutOfSupport",
          "allowedValues": ["Supported", "OutOfSupport", "Unknown"],
          "displayOrder": 3,
          "description": "OS support status that contributes to the high-risk condition."
        },
        {
          "parameterKey": "unknownSupportStatus",
          "parameterType": "string",
          "required": false,
          "defaultValue": "Unknown",
          "allowedValues": ["Unknown"],
          "displayOrder": 4,
          "description": "OS support status treated as unknown."
        }
      ],
      "outcomes": [
        {
          "outcomeKey": "not_production_context",
          "complianceStatus": "Compliant",
          "reasonTemplate": "Asset is not in production context.",
          "evidenceTemplate": null
        },
        {
          "outcomeKey": "missing_os_support",
          "complianceStatus": "Unknown",
          "reasonTemplate": "Production server OS support status is missing.",
          "evidenceTemplate": null
        },
        {
          "outcomeKey": "triggered",
          "complianceStatus": "Non-compliant",
          "reasonTemplate": "High Risk: Production server has critical vulnerability on unsupported OS.",
          "evidenceTemplate": null
        },
        {
          "outcomeKey": "not_triggered",
          "complianceStatus": "Compliant",
          "reasonTemplate": "High Risk condition not triggered.",
          "evidenceTemplate": null
        }
      ]
    },
