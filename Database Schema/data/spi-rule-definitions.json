{
  "updatedAt": "2026-03-22T00:00:00.000Z",
  "rules": [
    {
      "ruleKey": "os-support",
      "handlerKey": "os-support",
      "displayOrder": 1,
      "name": "Operating System Support Rule",
      "description": "Evaluates operating system vendor support status for servers and workstations.",
      "enabled": true,
      "parameters": [
        {
          "parameterKey": "unsupportedStatus",
          "parameterType": "string",
          "required": false,
          "defaultValue": "OutOfSupport",
          "allowedValues": ["Supported", "OutOfSupport", "Unknown"],
          "displayOrder": 1,
          "description": "Support status treated as non-compliant."
        },
        {
          "parameterKey": "unknownSupportStatus",
          "parameterType": "string",
          "required": false,
          "defaultValue": "Unknown",
          "allowedValues": ["Unknown"],
          "displayOrder": 2,
          "description": "Support status treated as unknown."
        }
      ],
      "outcomes": [
        {
          "outcomeKey": "missing_os_data",
          "complianceStatus": "Unknown",
          "reasonTemplate": "Operating system data is missing.",
          "evidenceTemplate": null
        },
        {
          "outcomeKey": "unsupported",
          "complianceStatus": "Non-compliant",
          "reasonTemplate": "Operating system is out of support.",
          "evidenceTemplate": null
        },
        {
          "outcomeKey": "supported",
          "complianceStatus": "Compliant",
          "reasonTemplate": "Operating system is vendor supported.",
          "evidenceTemplate": null
        }
      ]
    },
    {
      "ruleKey": "os-n-minus",
      "handlerKey": "os-n-minus",
      "displayOrder": 2,
      "name": "Operating System N-Minus Rule",
      "description": "Evaluates operating system currency against the configured N-minus threshold.",
      "enabled": true,
      "parameters": [
        {
          "parameterKey": "maxNMinus",
          "parameterType": "number",
          "required": false,
          "defaultValue": "2",
          "allowedValues": [],
          "displayOrder": 1,
          "description": "Maximum compliant N-minus distance."
        }
      ],
      "outcomes": [
        {
          "outcomeKey": "missing_n_minus",
          "complianceStatus": "Unknown",
          "reasonTemplate": "N-minus metadata is missing.",
          "evidenceTemplate": null
        },
        {
          "outcomeKey": "within_n_minus",
          "complianceStatus": "Compliant",
          "reasonTemplate": "OS is within N-{maxNMinus} range.",
          "evidenceTemplate": null
        },
        {
          "outcomeKey": "older_than_n_minus",
          "complianceStatus": "Non-compliant",
          "reasonTemplate": "OS major version is older than N-{maxNMinus}.",
          "evidenceTemplate": null
        }
      ]
    },
    {
      "ruleKey": "server-critical-vulnerability",
      "handlerKey": "server-critical-vulnerability",
      "displayOrder": 3,
      "name": "Server Critical Vulnerability Rule",
      "description": "Evaluates whether a server has vulnerabilities at the configured severity.",
      "enabled": true,
      "parameters": [
        {
          "parameterKey": "vulnerabilitySeverity",
          "parameterType": "string",
          "required": false,
          "defaultValue": "Critical",
          "allowedValues": ["Low", "Medium", "High", "Critical"],
          "displayOrder": 1,
          "description": "Vulnerability severity that triggers non-compliance."
        }
      ],
      "outcomes": [
        {
          "outcomeKey": "critical_vulnerability_present",
          "complianceStatus": "Non-compliant",
          "reasonTemplate": "Server has one or more critical vulnerabilities.",
          "evidenceTemplate": null
        },
        {
          "outcomeKey": "no_critical_vulnerability",
          "complianceStatus": "Compliant",
          "reasonTemplate": "No critical server vulnerabilities present.",
          "evidenceTemplate": null
        }
      ]
    },
    {
