{
  "name": "tsaat-demo-lite",
  "version": "1.0.0",
  "private": true,
  "description": "Single-file offline TSAAT demonstration application",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "verify": "node scripts/verify-single-file.mjs",
    "smoke": "node scripts/smoke-browser.mjs",
    "test": "npm run typecheck && npm run build && npm run verify && npm run smoke"
  },
