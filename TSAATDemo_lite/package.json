    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-is": "^18.2.0",
    "recharts": "^3.7.0",
    "three": "^0.181.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.24",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.6",
    "puppeteer-core": "^24.37.5",
    "tailwindcss": "3.4.17",
    "typescript": "^5.9.3"
  }
