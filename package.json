{
  "name": "tsaat-ui-3",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "tsx scripts/generate-seed.ts",
    "seed:validate": "tsx scripts/validate-seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --incremental false",
    "docs:generate": "node scripts/docs-maintenance.mjs --write",
    "docs:check": "node scripts/docs-maintenance.mjs --check",
    "repo:check": "node scripts/repository-check.mjs",
    "check": "npm run repo:check && npm run docs:check && npm run lint && npm run typecheck && npm test && npm run test:tooling",
    "setup:database": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-db-config.ps1",
    "setup:login": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-logindetails.ps1",
    "db:bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-demo-database.ps1",
    "test:tooling": "node --test tests/documentation-maintenance.test.mjs tests/runtime-reachability.test.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^14.2.35",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^24.37.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-is": "^18.2.0",
    "recharts": "^3.7.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "@types/papaparse": "^5.5.2",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@types/three": "^0.181.0",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "eslint": "8.57.0",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
