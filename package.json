{
  "name": "tsaat-ui-3",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-app.mjs dev sql",
    "build": "node scripts/run-app.mjs build sql",
    "start": "node scripts/run-app.mjs start sql",
    "lint": "next lint",
    "seed": "tsx scripts/generate-seed.ts",
    "seed:validate": "tsx scripts/validate-seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --incremental false",
    "docs:generate": "node scripts/docs-maintenance.mjs --write",
    "docs:check": "node scripts/docs-maintenance.mjs --check",
    "repo:check": "node scripts/repository-check.mjs",
    "check": "npm run offline:check && npm run repo:check && npm run docs:check && npm run lint && npm run typecheck && npm test && npm run test:tooling && npm run storage:check",
    "setup:database": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-db-config.ps1",
    "db:bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-demo-database.ps1",
    "test:tooling": "node --test tests/documentation-maintenance.test.mjs tests/runtime-reachability.test.mjs tests/offline-build.test.mjs",
    "build:sql": "node scripts/run-app.mjs build sql",
    "build:nosql": "node scripts/run-app.mjs build nosql",
    "dev:sql": "node scripts/run-app.mjs dev sql",
    "dev:nosql": "node scripts/run-app.mjs dev nosql",
    "start:sql": "node scripts/run-app.mjs start sql",
    "start:nosql": "node scripts/run-app.mjs start nosql",
    "build:all": "npm run build:sql && npm run build:nosql",
    "setup:nosql": "node scripts/setup-json-store.mjs",
    "populate:nosql": "node scripts/populate-json-store.mjs",
    "populate:vulnerabilities": "node scripts/populate-vulnerability-metadata.mjs",
    "populate:patches": "node scripts/populate-patch-management.mjs",
    "storage:check": "node scripts/check-data-providers.mjs",
    "test:nosql": "node --import tsx scripts/test-nosql.mjs",
    "offline:check": "node scripts/offline-dependencies.mjs --check",
    "offline:refresh": "node scripts/offline-dependencies.mjs --refresh",
    "enrich:nosql": "node --import tsx scripts/enrich-nosql-coverage.mjs",
    "migrate:security-domains": "node scripts/migrate-security-domains.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^14.2.35",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^24.37.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-is": "^18.2.0",
    "recharts": "^3.7.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "@types/papaparse": "^5.5.2",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@types/three": "^0.181.0",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "eslint": "8.57.0",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
